{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arachne-telegram",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "CONSULT_LIMIT",
      "namespace_id": "18051",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAYMENT_NOTICES",
        "class_name": "PaymentNotice"
      }
    ]
  },
  "migrations": [
    {
      "tag": "payments-v1",
      "new_sqlite_classes": [
        "PaymentNotice"
      ]
    }
  ]
}
