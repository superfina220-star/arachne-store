{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arachne-telegram",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "arachne.okcept.ru/api/consult", "zone_name": "okcept.ru" }
  ],
  "ratelimits": [
    { "name": "CONSULT_LIMIT", "namespace_id": "18051", "simple": { "limit": 5, "period": 60 } }
  ]
}
